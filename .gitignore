# ================================
# Ollama / Model
# ================================
# 모델 파일 (수 GB 단위, git에 올리면 안 됨)
models/
*.gguf
*.bin
*.safetensors
*.ggml
*.pt
*.pth

# Ollama 데이터 디렉토리 (bind mount 경로)
ollama_data/*
!ollama_data/.gitkeep

# ================================
# Ollama 서버 로그 (nohup 출력)
# ================================
ollama.log
nohup.out

# ================================
# Docker
# ================================
# 로컬 override 설정 (포트, 볼륨 등 개인 환경 차이)
docker-compose.override.yml
docker-compose.local.yml

# Docker 빌드 캐시/임시 파일
.dockerignore.local

# ================================
# 환경 변수 / 시크릿
# ================================
.env
.env.*
!.env.example        # 예시 파일은 커밋 허용
*.pem
*.key
secrets/

# ================================
# macOS
# ================================
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ================================
# VSCode
# ================================
.vscode/*
!.vscode/extensions.json   # 팀 공유용 추천 익스텐션은 허용
!.vscode/settings.json     # 프로젝트 공통 설정은 허용 (선택)

# ================================
# Python (FastAPI / 스크립트 등)
# ================================
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ================================
# 로그 / 임시 파일
# ================================
logs/
*.log
*.tmp
*.swp
*.bak
.cache/

# ================================
# 기타
# ================================
.idea/          # JetBrains
*.iml